{
  "private": false,
  "displayName": "Ambient Weather",
  "name": "@bcourbage/homebridge-ambient-weather-sensors",
  "version": "2.0.0-beta.8",
  "description": "Independently maintained Homebridge plugin for Ambient Weather sensors via the AWN REST/websocket API, with Homebridge 2.x support, multi-station support, realtime updates, and CO2/PM coverage.",
  "license": "Apache-2.0",
  "author": "Bruno Courbage (https://github.com/bcourbage)",
  "contributors": [
    "Deac Karns (https://github.com/peledies)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bcourbage/homebridge-ambient-weather-sensors"
  },
  "bugs": {
    "url": "https://github.com/bcourbage/homebridge-ambient-weather-sensors/issues"
  },
  "homepage": "https://github.com/bcourbage/homebridge-ambient-weather-sensors#readme",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "type": "module",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "config.schema.json",
    "images/icon.png",
    "CHANGELOG.md",
    "NOTICE",
    "UPGRADING.md",
    "MultiHome.md",
    "homebridge-ui/server.js",
    "homebridge-ui/handlers.js",
    "homebridge-ui/public"
  ],
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "clean": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true}); ['server.js','handlers.js'].forEach(f => require('fs').rmSync('./homebridge-ui/' + f, {force: true}))\"",
    "build:plugin": "node ./node_modules/typescript/bin/tsc",
    "build:ui": "node ./node_modules/typescript/bin/tsc -p homebridge-ui/tsconfig.json",
    "build": "npm run clean && npm run build:plugin && npm run build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "ambient-weather",
    "weather-station",
    "homekit",
    "awn",
    "websocket",
    "co2",
    "air-quality",
    "pm2.5"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "homebridge": "^2.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "volta": {
    "node": "22.12.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.4",
    "socket.io-client": "^4.8.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
