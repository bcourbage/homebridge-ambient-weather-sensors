{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "awn-editor": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "app-src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "app-src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": false,
            "polyfills": [],
            "outputPath": { "base": "public/app", "browser": "" },
            "outputHashing": "all",
            "aot": true,
            "styles": [],
            "sourceMap": false,
            "namedChunks": false,
            "extractLicenses": true,
            "optimization": true,
            "budgets": [
              { "type": "initial", "maximumWarning": "500kB", "maximumError": "800kB" }
            ]
          }
        }
      }
    }
  }
}
